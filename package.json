{
  "name": "gwiza_template",
  "version": "1.0.0",
  "description": "Internal company's best practices and coding standards template",
  "main": "index.ts",
  "author": "Simon Imanigirimpuhwe",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "jest --coverage",
    "build": "npx tsc",
    "dev": "nodemon src/index.ts",
    "start": "cross-env ENV=production && yarn build && node ./dist/index.js",
    "migrate": "npx prisma migrate",
    "migrate:reset": "npx prisma migrate reset",
    "generate": "npx prisma generate",
    "migrate:deploy": "npx prisma migrate deploy",
    "prisma:studio": "npx prisma studio",
    "prepare": "husky",
    "clean": "rimraf dist node_modules",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "qlty": "sh ./qlty.sh"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.2",
    "@prisma/client": "^6.8.1",
    "amqplib": "^0.10.8",
    "axios": "^1.13.2",
    "envalid": "^8.1.1",
    "fastify": "^5.3.3",
    "i18next": "^25.7.3",
    "i18next-fs-backend": "^2.6.1",
    "ioredis": "^5.8.2",
    "joi": "^17.13.3",
    "joi-to-swagger": "^6.2.0",
    "logform": "^2.7.0",
    "mysql2": "^3.14.1",
    "prisma": "^6.8.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.28.0",
    "eslint-plugin-prettier": "^5.4.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
